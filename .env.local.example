# The password you type to log into this admin site.
ADMIN_PASSWORD=change-me

# Any long random string — used to sign the login session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-too

# The existing Flask backend (same one the Oren Flutter app talks to).
FLASK_API_URL=https://readdata-production.up.railway.app

# Must match the ADMIN_TOKEN already set on that backend (Railway env vars) —
# this is what authenticates this site's server-side calls to /api/admin/*.
FLASK_ADMIN_TOKEN=same-value-as-backend-ADMIN_TOKEN
